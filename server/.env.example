# Choose one: "gemini" or "openai"
LLM_PROVIDER=gemini

# Google Gemini API key (free at aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API key (alternative)
OPENAI_API_KEY=your_openai_api_key_here

# Optional model overrides. Leave unset to use the built-in defaults
# (gemini-3.6-flash for gemini, gpt-4o-mini for openai).
# GEMINI_MODEL=gemini-3.6-flash
# OPENAI_MODEL=gpt-4o-mini

# Comma-separated production origins. Omit locally to allow any origin.
# ALLOWED_ORIGINS=https://your-app.example.com

PORT=3001
